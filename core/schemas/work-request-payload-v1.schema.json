{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://core/schemas/work-request-payload-v1.schema.json",
  "title": "Work Request Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["desired_outcome", "authorized_actions", "excluded_scope", "input_refs", "protection_boundaries", "required_decisions", "verification_levels"],
  "properties": {
    "desired_outcome": {"type": "string", "minLength": 1},
    "authorized_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "excluded_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "protection_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_levels": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
