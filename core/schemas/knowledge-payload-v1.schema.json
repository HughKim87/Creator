{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kim-silver-youtube:schema:knowledge-payload:v1",
  "title": "Knowledge Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["statement", "classification", "scope", "source_ids", "verification_status", "verified_by"],
  "properties": {
    "statement": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$"},
    "classification": {"enum": ["fact", "inference", "procedure", "constraint"]},
    "scope": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "verification_status": {"enum": ["candidate", "verified"]},
    "verified_by": {"type": ["string", "null"]}
  }
}
