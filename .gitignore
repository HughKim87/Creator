# Context-system cross-process coordination
catalog/.context-system.lock

# Python runtime caches
__pycache__/
*.pyc

# Project-local disposable runtime dependencies
/extension/.runtime/

# Protected user media and derived outputs
**/inputs/
**/outputs/

# Obsidian local UI and workspace state; keep only the shared safety config
.obsidian/*
!.obsidian/app.json

# Generated extension work data
extension/data/

# Job-scoped media, approvals, logs and scratch stay local.
/extension/jobs/

# Launcher diagnostics are runtime logs, not maintained source.
/extension/work/voice-tts-launcher/*.log
