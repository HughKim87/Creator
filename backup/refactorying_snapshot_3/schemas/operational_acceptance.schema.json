{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/operational_acceptance.schema.json",
  "title": "Fixed operational acceptance scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "design_source", "thresholds", "scenarios"],
  "properties": {
    "schema_version": {"type": "string"},
    "evaluation_id": {"type": "string"},
    "design_source": {"type": "string"},
    "thresholds": {
      "type": "object",
      "required": ["required_scenarios", "maximum_failed", "maximum_rule_file_leakage"],
      "properties": {
        "required_scenarios": {"const": 9},
        "maximum_failed": {"const": 0},
        "maximum_rule_file_leakage": {"const": 0}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "scenario_kind", "expected"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^r5\\.[0-9]{2}\\.[a-z0-9-]+$"},
          "scenario_kind": {
            "enum": [
              "file_lifecycle",
              "source_review_transition",
              "conflict_supersession_coexistence",
              "partial_failure_resume",
              "index_delete_cold_rebuild",
              "new_session_cold_start",
              "protected_namespace_isolation",
              "real_task_leakage",
              "feedback_next_context"
            ]
          },
          "expected": {"type": "object"}
        }
      }
    }
  }
}
