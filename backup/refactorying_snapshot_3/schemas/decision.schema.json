{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/decision.schema.json",
  "title": "Accepted project decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "decision_id", "legacy_id", "title", "statement", "status", "rationale", "approval", "source_refs", "relation_ids", "retrieval_eligible", "task_tags"],
  "properties": {
    "schema_version": {"type": "string"},
    "record_kind": {"const": "decision"},
    "decision_id": {"type": "string", "pattern": "^decision\\.[a-z0-9._-]+$"},
    "legacy_id": {"type": "string", "pattern": "^D-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "superseded", "rejected", "candidate"]},
    "rationale": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "evidence_source_id", "locator"],
      "properties": {
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string"},
        "evidence_source_id": {"type": "string"},
        "locator": {"type": "string"}
      }
    },
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
    "relation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "retrieval_eligible": {"type": "boolean"},
    "task_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {"source_id": {"type": "string"}, "locator": {"type": "string"}}
    }
  }
}
