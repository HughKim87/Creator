#!/bin/sh

ROOT="$(git rev-parse --show-toplevel)" || exit $?
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv executable not found" >&2
  exit 127
fi

UV="$(command -v uv)" || exit 127
case "$UV" in
  *.exe) ;;
  *)
    if [ -f "${UV}.exe" ]; then
      UV="${UV}.exe"
    fi
    ;;
esac
UV_NATIVE="$UV"
if command -v cygpath >/dev/null 2>&1; then
  UV_NATIVE="$(cygpath -w "$UV")" || exit 127
fi
cd "$ROOT" || exit 1
PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 VIDEO_WORKFLOW_UV="$UV_NATIVE" \
  "$UV" run --locked --offline --no-cache workflow check --scope fast
STATUS=$?
exit "$STATUS"
