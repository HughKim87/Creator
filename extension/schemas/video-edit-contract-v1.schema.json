{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://extension/schemas/video-edit-contract-v1.schema.json",
  "title": "Video edit decision contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "phase",
    "time_references",
    "deliverable",
    "calibration",
    "events",
    "feedback",
    "state",
    "validation"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "phase": {"enum": ["calibration", "full"]},
    "time_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "raw", "coordinate_system", "unit", "scope", "confirmed_by"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "raw": {"type": "string", "minLength": 1},
          "coordinate_system": {"enum": ["source", "timeline"]},
          "unit": {"enum": ["timecode", "seconds", "frames"]},
          "scope": {"type": "string", "minLength": 1},
          "confirmed_by": {"enum": ["user", "conversation_correction"]}
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "sequence_mode", "allowed_sidecars"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "sequence_mode": {"enum": ["single_continuous", "multiple_explicit"]},
        "allowed_sidecars": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "approved_by", "approval_evidence"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["pending", "approved", "rejected", "not_required"]},
        "approved_by": {"type": ["string", "null"]},
        "approval_evidence": {"type": ["string", "null"]}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "source_in",
          "source_out",
          "depends_on",
          "microbeat_status",
          "continuity_reason"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {
            "enum": [
              "setup",
              "cause",
              "discovery",
              "action",
              "attempt",
              "reaction",
              "escape",
              "result",
              "transition",
              "state_change",
              "atmosphere"
            ]
          },
          "source_in": {"type": "integer", "minimum": 0},
          "source_out": {"type": "integer", "minimum": 1},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "microbeat_status": {"enum": ["reviewed", "uncuttable_reviewed", "pending"]},
          "continuity_reason": {"type": ["string", "null"]}
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_locks", "defects", "untouched"],
      "properties": {
        "positive_locks": {"$ref": "#/$defs/preservation_list"},
        "untouched": {"$ref": "#/$defs/preservation_list"},
        "defects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source_anchor", "status", "evidence", "approved_by"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source_anchor": {"type": "string", "minLength": 1},
              "status": {"enum": ["resolved", "approved_defer", "unreproduced"]},
              "evidence": {"type": "string", "minLength": 1},
              "approved_by": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_conflict", "current_artifact_id", "source_manifest_hash", "source_revision_status"],
      "properties": {
        "owner_conflict": {"type": "boolean"},
        "current_artifact_id": {"type": "string", "minLength": 1},
        "source_manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_revision_status": {"enum": ["current", "use_prohibited", "historical"]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["causal_space", "tempo_repetition", "av_boundary", "semantic_gate", "reviewed_by", "editorial_score"],
      "properties": {
        "causal_space": {"$ref": "#/$defs/pass_status"},
        "tempo_repetition": {"$ref": "#/$defs/pass_status"},
        "av_boundary": {"$ref": "#/$defs/pass_status"},
        "semantic_gate": {"enum": ["not_run", "passed", "failed"]},
        "reviewed_by": {"type": ["string", "null"], "minLength": 1},
        "editorial_score": {
          "oneOf": [
            {"const": "not_scored"},
            {"type": "number", "minimum": 0, "maximum": 100}
          ]
        }
      }
    }
  },
  "$defs": {
    "preservation_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "preserved"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "preserved": {"type": "boolean"}
        }
      }
    },
    "pass_status": {"enum": ["not_run", "passed", "failed", "not_applicable"]}
  }
}
