{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://extension/schemas/local-runtime-v1.schema.json",
  "title": "Project-local optional runtime manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "runtime_root",
    "retention",
    "tree_digest",
    "verified_on",
    "components"
  ],
  "properties": {
    "$schema": {"const": "../schemas/local-runtime-v1.schema.json"},
    "schema_version": {"const": "local-runtime-v1"},
    "runtime_root": {"const": "extension/.runtime"},
    "retention": {"const": "gitignored-local-capability"},
    "tree_digest": {
      "const": "sha256(sorted-posix-path-ordinal|bytes|sha256-with-lf)"
    },
    "verified_on": {"type": "string", "format": "date"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criticalFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "model_url": ["model_sha1"],
        "model_sha1": ["model_url"]
      },
      "required": [
        "project_url",
        "distribution_url",
        "release_label",
        "source_commit",
        "license",
        "license_path",
        "reinstall"
      ],
      "properties": {
        "project_url": {"type": "string", "format": "uri"},
        "distribution_url": {"type": "string", "format": "uri"},
        "release_label": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "model_url": {"type": "string", "format": "uri"},
        "model_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 1},
        "license_path": {
          "oneOf": [
            {"$ref": "#/$defs/relativePath"},
            {"type": "null"}
          ]
        },
        "reinstall": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "role",
        "version",
        "platform",
        "relative_root",
        "file_count",
        "bytes",
        "tree_sha256",
        "critical_files",
        "probe",
        "source"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "status": {
          "enum": ["retained-shared-tool", "retained-optional-backend"]
        },
        "role": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "platform": {"const": "windows-x86_64"},
        "relative_root": {"$ref": "#/$defs/relativePath"},
        "file_count": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "critical_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/criticalFile"}
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["ffmpeg", "whisper_cpp", "none"]}
          }
        },
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
