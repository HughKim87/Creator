{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/relation.schema.json",
  "title": "Typed corpus relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "relation_id", "relation_type", "source_record_id", "target_record_id", "status", "review_status", "source_refs", "retrieval_eligible"],
  "properties": {
    "schema_version": {"type": "string"},
    "record_kind": {"const": "relation"},
    "relation_id": {"type": "string", "pattern": "^relation\\.[a-z0-9._-]+$"},
    "relation_type": {"enum": ["supported_by", "resolved_by", "implements", "derived_from", "supersedes", "related_to"]},
    "source_record_id": {"type": "string"},
    "target_record_id": {"type": "string"},
    "status": {"enum": ["active", "candidate", "superseded"]},
    "review_status": {"enum": ["verified", "pending", "rejected"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "locator"], "properties": {"source_id": {"type": "string"}, "locator": {"type": "string"}}}},
    "retrieval_eligible": {"type": "boolean"}
  }
}
