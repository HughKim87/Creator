{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/knowledge.schema.json",
  "title": "Source-traceable project knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "knowledge_id", "title", "language", "classification", "statement", "created_at", "updated_at", "author", "status", "confidence", "confidence_basis", "validated_by", "validated_at", "source_refs", "relation_ids", "validity_scope", "last_checked_at", "review_policy", "review_due_at", "review_triggers", "revision", "retrieval_eligible", "task_tags"],
  "properties": {
    "schema_version": {"type": "string"},
    "record_kind": {"const": "knowledge"},
    "knowledge_id": {"type": "string", "pattern": "^knowledge\\.[a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "classification": {"enum": ["fact", "inference", "procedure", "constraint"]},
    "statement": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "author": {"type": "string"},
    "status": {"enum": ["verified", "candidate", "reviewed", "needs_review", "superseded", "rejected"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "confidence_basis": {"type": "string", "minLength": 1},
    "validated_by": {"type": "string"},
    "validated_at": {"type": "string"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
    "relation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validity_scope": {"type": "string", "minLength": 1},
    "last_checked_at": {"type": "string"},
    "review_policy": {"enum": ["event_driven", "scheduled"]},
    "review_due_at": {"type": ["string", "null"]},
    "review_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "revision": {"type": "integer", "minimum": 1},
    "retrieval_eligible": {"type": "boolean"},
    "task_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {"source_id": {"type": "string"}, "locator": {"type": "string"}}
    }
  }
}
