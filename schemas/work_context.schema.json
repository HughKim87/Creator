{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/work_context.schema.json",
  "title": "Resolved task-scoped work context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "request", "request_hash", "as_of", "authority", "read_manifest", "exclusions", "write_contract"],
  "properties": {
    "schema_version": {"type": "string"},
    "context_id": {"type": "string"},
    "request": {"type": "object"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "as_of": {"type": "string"},
    "authority": {
      "type": "object",
      "required": ["user_scope", "kernel_rule_ids", "selected_conditional_rule_ids", "predicate_evidence"],
      "properties": {
        "user_scope": {"type": "object"},
        "kernel_rule_ids": {"type": "array", "items": {"type": "string"}},
        "selected_conditional_rule_ids": {"type": "array", "items": {"type": "string"}},
        "predicate_evidence": {"type": "object"}
      }
    },
    "read_manifest": {"type": "array", "items": {"type": "object"}},
    "exclusions": {"type": "array", "items": {"type": "object"}},
    "write_contract": {"type": ["object", "null"]}
  }
}
