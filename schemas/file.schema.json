{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/file.schema.json",
  "title": "Project-governed file catalog node",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "file_id", "path", "kind", "purpose", "owner", "authority", "status", "language", "sensitivity", "index_scope", "read_when", "write_when", "task_tags", "unit_strategy", "unit_overrides", "consumes", "produces", "depends_on", "validators", "content_sha256", "hash_policy", "observed_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "file_id": {"type": "string", "pattern": "^file\\.[a-z0-9.-]+$"},
    "path": {"type": "string", "minLength": 1},
    "kind": {"type": "string"},
    "purpose": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "authority": {"type": "string"},
    "status": {"enum": ["planned", "active", "moved", "deleted"]},
    "language": {"type": "string"},
    "sensitivity": {"enum": ["public_project", "internal_project", "protected_task", "secret"]},
    "index_scope": {"enum": ["global", "task", "none"]},
    "read_when": {"type": "array", "items": {"type": "string"}},
    "write_when": {"type": "array", "items": {"type": "string"}},
    "task_tags": {"type": "array", "items": {"type": "string"}},
    "unit_strategy": {"enum": ["whole_file", "markdown_heading", "json_pointer", "jsonl_record_id"]},
    "unit_overrides": {"type": "array", "items": {"type": "object"}},
    "consumes": {"type": "array", "items": {"type": "string"}},
    "produces": {"type": "array", "items": {"type": "string"}},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "validators": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "hash_policy": {"enum": ["content_sha256", "catalog_runtime_hash", "projection_runtime_hash", "planned"]},
    "runtime_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "observed_at": {"type": "string"},
    "moved_from": {"type": "array", "items": {"type": "string"}}
  }
}
