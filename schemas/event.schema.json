{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/event.schema.json",
  "title": "Append-only work event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "timestamp", "event_type", "actor", "task_id", "target_paths", "before_hashes", "after_hashes", "result", "previous_event_hash", "event_hash"],
  "properties": {
    "schema_version": {"type": "string"},
    "event_id": {"type": "string", "pattern": "^event\\.[a-z0-9._-]+$"},
    "timestamp": {"type": "string"},
    "event_type": {"enum": ["manual_bootstrap", "catalog_sync", "context_resolved", "write_applied", "write_rejected", "validation"]},
    "actor": {"type": "string"},
    "task_id": {"type": ["string", "null"]},
    "target_paths": {"type": "array", "items": {"type": "string"}},
    "before_hashes": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "after_hashes": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "result": {"enum": ["success", "rejected", "failed"]},
    "details": {"type": "object"},
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
