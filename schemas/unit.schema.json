{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/unit.schema.json",
  "title": "Addressable artifact unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit_id", "file_id", "locator_type", "locator", "purpose", "read_when", "write_when", "owner", "validators", "parent_file_hash", "unit_hash", "task_tags", "status"],
  "properties": {
    "schema_version": {"type": "string"},
    "unit_id": {"type": "string", "pattern": "^unit\\.[a-z0-9.-]+$"},
    "file_id": {"type": "string", "pattern": "^file\\.[a-z0-9.-]+$"},
    "locator_type": {"enum": ["whole_file", "markdown_heading", "json_pointer", "jsonl_record_id"]},
    "locator": {"type": "string"},
    "purpose": {"type": "string"},
    "read_when": {"type": "array", "items": {"type": "string"}},
    "write_when": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"},
    "validators": {"type": "array", "items": {"type": "string"}},
    "parent_file_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "unit_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "task_tags": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["active", "needs_review", "superseded"]}
  }
}
