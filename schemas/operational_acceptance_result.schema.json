{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/operational_acceptance_result.schema.json",
  "title": "Operational acceptance result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "evaluated_at", "source_evaluation_path", "source_evaluation_sha256", "scenarios", "logical_result_hash", "summary", "ok"],
  "properties": {
    "schema_version": {"type": "string"},
    "evaluation_id": {"type": "string"},
    "evaluated_at": {"type": "string"},
    "source_evaluation_path": {"type": "string"},
    "source_evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "scenario_kind", "passed", "evidence"],
        "properties": {
          "scenario_id": {"type": "string"},
          "scenario_kind": {"type": "string"},
          "passed": {"type": "boolean"},
          "evidence": {"type": "object"},
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "logical_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "required": ["scenarios", "passed", "failed", "rule_file_leakage"],
      "properties": {
        "scenarios": {"type": "integer"},
        "passed": {"type": "integer"},
        "failed": {"type": "integer"},
        "rule_file_leakage": {"type": "integer"}
      }
    },
    "ok": {"type": "boolean"}
  }
}
