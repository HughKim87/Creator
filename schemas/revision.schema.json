{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/revision.schema.json",
  "title": "Append-only record revision history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_id", "record_id", "record_kind", "from_revision", "to_revision", "actor", "timestamp", "reason", "before_hash", "after_hash", "previous_revision_hash", "revision_hash"],
  "properties": {
    "schema_version": {"type": "string"},
    "revision_id": {"type": "string", "pattern": "^revision\\.[a-z0-9._-]+$"},
    "record_id": {"type": "string"},
    "record_kind": {"enum": ["knowledge", "source", "decision", "case", "relation"]},
    "from_revision": {"type": ["integer", "null"]},
    "to_revision": {"type": "integer", "minimum": 1},
    "actor": {"type": "string"},
    "timestamp": {"type": "string"},
    "reason": {"type": "string"},
    "before_hash": {"type": ["string", "null"]},
    "after_hash": {"type": "string"},
    "previous_revision_hash": {"type": ["string", "null"]},
    "revision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
