{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project://schemas/write_contract.schema.json",
  "title": "Bounded write contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "request_hash", "allowed_actions", "targets", "selected_rule_ids", "validators", "required_updates"],
  "properties": {
    "schema_version": {"type": "string"},
    "contract_id": {"type": "string"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_actions": {"type": "array", "items": {"enum": ["create", "write"]}, "minItems": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_id", "path", "status", "before_file_hash", "owner", "authority", "write_when", "validators"],
        "properties": {
          "file_id": {"type": "string"},
          "path": {"type": "string"},
          "status": {"enum": ["planned", "active"]},
          "before_file_hash": {"type": ["string", "null"]},
          "unit_ids": {"type": "array", "items": {"type": "string"}},
          "before_unit_hashes": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
          "owner": {"type": "string"},
          "authority": {"type": "string"},
          "write_when": {"type": "array", "items": {"type": "string"}},
          "validators": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "selected_rule_ids": {"type": "array", "items": {"type": "string"}},
    "validators": {"type": "array", "items": {"type": "string"}},
    "required_updates": {"type": "array", "items": {"enum": ["catalog", "units", "event", "handoff"]}}
  }
}
