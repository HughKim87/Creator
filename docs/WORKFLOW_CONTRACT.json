{
  "schema_version": 1,
  "contract_id": "closed_loop_video_workflow",
  "role": "Machine-readable source of truth for cross-video phase gates and promotion rules.",
  "read_when": "Before changing workflow state, creating an edit candidate, or promoting an artifact.",
  "retention": "Keep while this workflow is active; revise in place with tests instead of cloning it.",
  "state_path": "outputs/WORKFLOW_STATE.json",
  "rule_registry_path": "outputs/WORKFLOW_RULE_REGISTRY.json",
  "edit_change_ledger_path": "outputs/07_edit_export/EDIT_CHANGE_LEDGER.json",
  "edit_memory_view_path": "outputs/07_edit_export/edit_memory/CURRENT.json",
  "phase_order": [
    "data_analysis",
    "planning",
    "edit_calibration",
    "edit_full",
    "validation",
    "final"
  ],
  "execution_request": {
    "reset_phrases": [
      "proceed",
      "continue",
      "resume",
      "진행해",
      "계속",
      "재개"
    ],
    "same_objective_failure_limit": 3,
    "counter_scope": "one_user_execution_request",
    "carry_between_requests": false
  },
  "promotion_policy": {
    "default_deny": true,
    "waiver_requires_explicit_user_approval": true,
    "technical_success_is_quality_approval": false,
    "user_is_first_line_qa": false,
    "actual_av_review_required_for_final": true,
    "current_deliverable_requires_final_gate": true,
    "calibration_may_use_ai_reviewed_provisional_plan": true,
    "user_direction_checkpoint": "after_ai_self_reviewed_calibration",
    "one_user_creative_checkpoint_before_full_expansion": true,
    "data_reanalysis_requires_source_or_audience_change": true,
    "full_rebuild_requires_explicit_user_approval": true,
    "revision_model": "working_and_approved_baselines_plus_revision_dag"
  },
  "memory_policy": {
    "event_store_is_append_only": true,
    "working_baseline_may_advance_without_user_approval": true,
    "approved_baseline_requires_user_direction": true,
    "rejection_memory_survives_execution_request_reset": true,
    "feedback_is_cleared_only_by_explicit_superseding_event": true,
    "overall_score_requires_actual_av_observation": true
  },
  "validation_scope_policy": {
    "required_scopes": [
      "audio_signal",
      "edit_semantic",
      "continuous_av",
      "app",
      "user_direction"
    ],
    "allowed_statuses": [
      "pending",
      "passed",
      "failed",
      "not_required"
    ],
    "required_scope_fields": [
      "status",
      "evidence",
      "limitations"
    ],
    "scope_check_paths": {
      "audio_signal": "phases.edit_calibration.checks.audio_source_signal_analyzed",
      "edit_semantic": "phases.edit_calibration.checks.semantic_checks_passed",
      "continuous_av": "phases.validation.checks.full_av_playback_reviewed",
      "app": "phases.validation.checks.app_validated",
      "user_direction": "phases.edit_calibration.checks.user_direction_approved"
    },
    "tool_surface_failure_scope_is_local": true,
    "audio_signal_requires_browser_playback": false,
    "passed_scope_survives_unrelated_surface_failure": true,
    "blocker_checklist": [
      "required_scope_identified",
      "available_project_tools_checked",
      "existing_evidence_checked",
      "equivalent_methods_checked",
      "no_viable_alternative"
    ]
  },
  "transition_policy": {
    "require_immediate_predecessor_approval": true
  },
  "calibration_policy": {
    "scope": "smallest_set_covering_distinct_rhythms",
    "required_positions": [
      "opening",
      "middle",
      "ending"
    ],
    "agent_checks_before_user": [
      "audio_signal_analysis",
      "chronology",
      "speech_boundaries",
      "screen_audio_causality",
      "redundancy",
      "rhythm",
      "message_visible_without_review_metadata"
    ],
    "recommended_packages_shown_to_user": 1,
    "user_checkpoint_count_before_full_expansion": 1,
    "full_edit_before_user_checkpoint": false,
    "mp4_requires_current_request_authorization": true
  },
  "revision_routing": {
    "message_or_viewer_promise": [
      "planning",
      "edit_calibration"
    ],
    "rhythm_or_comedy": [
      "edit_calibration"
    ],
    "local_cut_or_boundary": [
      "affected_ranges_only"
    ],
    "source_fingerprint_or_target_audience_changed": [
      "data_analysis",
      "planning",
      "edit_calibration"
    ]
  },
  "transitions": {
    "planning": {
      "requires": [
        "phases.data_analysis.checks.source_identity_validated",
        "phases.data_analysis.checks.transcript_or_audio_index_validated",
        "phases.data_analysis.checks.scene_evidence_map_validated",
        "phases.data_analysis.checks.audience_interest_evidence_validated",
        "phases.data_analysis.checks.agent_semantic_reviewed"
      ],
      "rules_required_before": "planning"
    },
    "edit_calibration": {
      "requires": [
        "phases.data_analysis.approved_for_next_phase",
        "phases.planning.approved_for_next_phase",
        "phases.planning.checks.viewer_promise_defined",
        "phases.planning.checks.central_thesis_count_is_one",
        "phases.planning.checks.character_arc_defined",
        "phases.planning.checks.spine_linked_to_source_evidence",
        "phases.planning.checks.agent_red_team_reviewed",
        "calibration_generation_allowed"
      ],
      "rules_required_before": "edit_calibration"
    },
    "edit_full": {
      "requires": [
        "phases.edit_calibration.checks.baseline_and_changeset_recorded",
        "phases.edit_calibration.checks.automatic_checks_passed",
        "phases.edit_calibration.checks.semantic_checks_passed",
        "phases.edit_calibration.checks.audio_source_signal_analyzed",
        "phases.edit_calibration.checks.speech_boundary_analysis_validated",
        "phases.edit_calibration.checks.screen_audio_causality_validated",
        "phases.edit_calibration.checks.rhythm_analysis_validated",
        "phases.edit_calibration.checks.message_visible_without_review_metadata",
        "phases.edit_calibration.checks.agent_self_reviewed",
        "phases.edit_calibration.checks.user_direction_approved",
        "generation_lock_released"
      ],
      "rules_required_before": "edit_full"
    },
    "validation": {
      "requires": [
        "phases.edit_full.checks.full_cutlist_generated",
        "phases.edit_full.checks.automatic_checks_passed",
        "phases.edit_full.checks.semantic_checks_passed",
        "phases.edit_full.checks.regression_checks_passed"
      ],
      "rules_required_before": "validation"
    },
    "final": {
      "requires": [
        "phases.validation.checks.full_av_playback_reviewed",
        "phases.validation.checks.audio_listening_validated",
        "phases.validation.checks.app_validated",
        "phases.validation.checks.message_and_viewer_promise_validated",
        "phases.validation.checks.all_active_rules_passed",
        "phases.validation.checks.user_final_direction_approved"
      ],
      "rules_required_before": "final"
    }
  },
  "artifact_roles": [
    "draft",
    "calibration_candidate",
    "historical_failure_evidence",
    "approved_baseline",
    "current_deliverable",
    "superseded"
  ],
  "required_rule_fields": [
    "id",
    "status",
    "scope",
    "owner_phase",
    "rule",
    "source",
    "enforcement",
    "required_before",
    "verification_status",
    "evidence"
  ],
  "verification_statuses": [
    "pending",
    "passed",
    "failed",
    "superseded"
  ]
}
