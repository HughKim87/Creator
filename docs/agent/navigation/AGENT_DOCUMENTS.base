filters:
  and:
    - 'file.ext == "md"'
    - 'doc_id != null'
properties:
  doc_id:
    displayName: ID
  domain:
    displayName: Domain
  kind:
    displayName: Kind
  lifecycle:
    displayName: Lifecycle
  purpose:
    displayName: Purpose
  read_when:
    displayName: Read when
  authority:
    displayName: Authority
views:
  - type: table
    name: Active agent notes
    filters:
      and:
        - 'lifecycle == "active"'
        - 'language == "en"'
    order:
      - file.name
      - doc_id
      - domain
      - kind
      - purpose
      - read_when
      - authority
  - type: table
    name: Navigation
    filters:
      and:
        - 'domain == "navigation"'
        - 'lifecycle == "active"'
    order:
      - file.name
      - doc_id
      - purpose
      - read_when
      - authority
  - type: table
    name: Rebuild
    filters:
      and:
        - 'domain == "rebuild"'
        - 'lifecycle == "active"'
    order:
      - file.name
      - doc_id
      - purpose
      - read_when
      - authority
  - type: table
    name: Workflow
    filters:
      and:
        - 'domain == "workflow"'
        - 'lifecycle == "active"'
    order:
      - file.name
      - doc_id
      - purpose
      - read_when
      - authority
  - type: table
    name: Tooling
    filters:
      and:
        - 'domain == "tooling"'
        - 'lifecycle == "active"'
    order:
      - file.name
      - doc_id
      - purpose
      - read_when
      - authority
  - type: table
    name: State
    filters:
      and:
        - 'domain == "state"'
        - 'lifecycle == "active"'
    order:
      - file.name
      - doc_id
      - purpose
      - read_when
      - authority
  - type: table
    name: Historical evidence
    filters:
      and:
        - 'domain == "history"'
    order:
      - file.name
      - doc_id
      - lifecycle
      - purpose
